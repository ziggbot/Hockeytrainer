# Kopiera till .env för lokal utveckling (committa aldrig .env).
# Neon: använd "pooled connection string" från Neon-konsolen (värdnamnet innehåller "-pooler").
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hockeytrainer
PORT=3000
# Sätt till false när klubbarna är på plats för att stänga öppen registrering av nya klubbar.
ALLOW_CLUB_SIGNUP=true
